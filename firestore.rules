rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hanya akun admin (berdasarkan UID) yang boleh membaca & menulis.
    // GANTI teks di bawah dengan UID akun admin dari Firebase Console → Authentication → Users.
    // Boleh lebih dari satu: ['UID_SATU', 'UID_DUA']
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['L2Rn0Pj1v6SuoA6lpGeRYeabgPv2'];
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
